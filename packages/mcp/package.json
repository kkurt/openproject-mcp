    "build": "tsc -b",
    "start": "node ./dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openproject-agent/core": "workspace:*",
    "zod": "^4.4.3"

# --- OpenProject connection -------------------------------------------------
# Base URL of your OpenProject instance (no trailing /api/v3).
OPENPROJECT_URL=https://openproject.example.com
# API key: OpenProject -> My account -> Access tokens -> API. Used as HTTP Basic
# password with the fixed username "apikey". NEVER commit the real value.
OPENPROJECT_API_KEY=your-api-key-here

# --- MCP server safety (optional) -------------------------------------------
# Set to true to make the MCP server refuse all real writes (previews still work).
# OPENPROJECT_READONLY=false
# Comma-separated status names whose transitions always require human approval.
# OPENPROJECT_PROTECTED_TRANSITIONS=Closed,Rejected
# Status that start_work_package moves a work package to.
# OPENPROJECT_START_STATUS=In progress

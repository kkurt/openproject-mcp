{
  "openproject": {
    "url": "https://openproject.example.com",
    "apiKey": "env:OPENPROJECT_API_KEY"
  },
  "project": "testproject",
  "targetRepo": "/absolute/path/to/target/repo",
  "filters": {
    "types": ["Bug", "Feature"],
    "assignee": "me"
  },
  "board": {
    "name": "Kanban",
    "sourceColumn": "New"
  },
  "order": [
    ["priority", "desc"],
    ["id", "asc"]
  ],
  "statusFlow": {
    "start": "In progress",
    "success": "Developed",
    "blocked": "On hold"
  },
  "protectedTransitions": ["Closed", "Rejected"],
  "write": false,
  "claude": {
    "binPath": "claude",
    "maxTurns": 40,
    "timeoutMs": 1800000,
    "allowedTools": ["Read(./**)", "Edit(./**)", "Write(./**)", "Grep(./**)", "Glob(./**)", "Bash(npm test:*)", "mcp__openproject"],
    "disallowedTools": ["Bash(git:*)"],
    "addDirs": []
  }
}
